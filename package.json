{
  "name": "the-chosen-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "worker:dev": "npm run build && wrangler dev --port 8787",
    "worker:dev:no-build": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply the-chosen-one --local",
    "test": "vitest run --poolOptions.threads.singleThread=true --poolOptions.threads.isolate=false",
    "test:watch": "vitest --poolOptions.threads.singleThread=true --poolOptions.threads.isolate=false"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "lunar-javascript": "^1.7.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^4.50.0",
    "vue-tsc": "^2.1.10"
  }
}
